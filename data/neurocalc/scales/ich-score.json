  "metadata": {
    "kind": "point_sum",
    "name": "Intracerebral Hemorrhage (ICH) Score",
    "aliases": [
      "Hemphill ICH",
      "ICH mortality"
    ],
    "summary": "6-point baseline risk stratification tool for 30-day mortality in spontaneous intracerebral hemorrhage.",
    "short_name": "ICH Score",
    "time_estimate": "< 1 min",
    "subspecialties": [
      "Stroke",
      "Neurocritical Care"
    ],
    "clinical_pearls": [
      "Do NOT use the ICH Score alone as a basis for early withdrawal of life-sustaining treatment (self-fulfilling prophecy bias).",
      "Designed as a standardized grading and communication tool after ICH diagnosis rather than a serial neurological exam (unlike GCS).",
      "Pitfall — Early DNR/withdrawal confounding: Historical 30-day mortality estimates were heavily influenced by early care limitations and clinician gestalt; avoid using the score as the sole determinant of prognosis."
    ]
  },
