  "scoring": {
    "method": "formula",
    "min_score": 0,
    "max_score": 100,
    "unit": "%",
    "precision": 1,
    "formula_id": "smart2"
  },
  "interpretation": [
    {
      "id": "smart_low",
      "min": 0,
      "max": 9.9,
      "label": "Lower Residual Risk (<10%)",
      "severity": "normal",
      "summary": "10-year recurrent vascular event risk <10%. Maintain guideline-directed secondary prevention.",
      "refs": [{ "source_id": "hageman-2022-smart2", "locator": "Supp. Table 2" }]
    },
    {
      "id": "smart_mod",
      "min": 10.0,
      "max": 19.9,
      "label": "Moderate Residual Risk (10.0–19.9%)",
      "severity": "moderate",
      "summary": "10-year recurrent vascular event risk 10–19.9%. Review LDL-C, BP, glycemic, and antithrombotic intensification.",
      "refs": [{ "source_id": "hageman-2022-smart2", "locator": "Supp. Table 2" }]
    },
    {
      "id": "smart_high",
      "min": 20.0,
      "max": 29.9,
      "label": "High Residual Risk (20.0–29.9%)",
      "severity": "severe",
      "summary": "10-year recurrent vascular event risk 20–29.9%. Strongly consider intensive lipid-lowering, SGLT2i/GLP-1 RA, or dual-pathway inhibition if eligible.",
      "refs": [{ "source_id": "hageman-2022-smart2", "locator": "Supp. Table 2" }]
    },
    {
      "id": "smart_very_high",
      "min": 30.0,
      "max": null,
      "label": "Very High Residual Risk (>=30%)",
      "severity": "critical",
      "summary": "10-year recurrent vascular event risk >=30%. Urgent aggressive secondary prevention across all modifiable vascular targets.",
      "refs": [{ "source_id": "hageman-2022-smart2", "locator": "Supp. Table 2" }]
    }
  ],
