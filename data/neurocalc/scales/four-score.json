        }
      ],
      "title": "Respiration Assessment in Intubated Patients",
      "target_id": "four_resp",
      "target_type": "item",
      "bedside_steps": [
        "Observe ventilator flow/pressure waveforms and spontaneous respiratory rate vs set rate."
      ],
      "pitfalls_and_exceptions": [
        "Score 1 if triggering spontaneous breaths above the set ventilator rate; score 0 if purely ventilator-triggered or apneic."
      ]
