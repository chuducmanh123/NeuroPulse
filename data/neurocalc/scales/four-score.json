  "metadata": {
    "kind": "point_sum",
    "name": "Full outline of unresponsiveness score (FOUR score)",
    "aliases": [
      "FOUR",
      "coma score"
    ],
    "summary": "16-point coma scale evaluating Eye, Motor, Brainstem reflexes, and Respiration, ideal for intubated ICU patients.",
    "short_name": "FOUR Score",
    "time_estimate": "~1–2 min",
    "subspecialties": [
      "Neurocritical Care",
      "Stroke"
    ],
    "clinical_pearls": [
      "Detects locked-in syndrome via vertical eye tracking/blinking on command.",
      "Eliminates the verbal subscore limitation of GCS in intubated and nonverbal patients.",
      "Better stratifies coma severity among patients at the lowest GCS floor (GCS 3) and helps detect impending neurological decline.",
      "Demonstrates strong interrater reliability across clinicians with different levels of training (ICU nurses, ED physicians, and neurointensivists).",
      "Pitfall — Sedation & ocular weighting: Sedating medications can artifactually lower the score, and the scale is heavily weighted toward ocular/brainstem components."
    ]
  },
