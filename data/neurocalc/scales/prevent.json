  "metadata": {
    "kind": "formula",
    "name": "PREVENT (10-Year & 30-Year CVD Risk Equations)",
    "aliases": [
      "AHA PREVENT",
      "PREVENT Total CVD",
      "PREVENT ASCVD"
    ],
    "summary": "Race-free 2024 AHA PREVENT equations estimating 10-year (ages 30–79) and 30-year (ages 30–59) risks of ASCVD, heart failure, CHD, stroke, and total CVD using CKM health predictors and optional uACR, HbA1c, and SDI.",
    "short_name": "PREVENT",
    "time_estimate": "~1–2 min",
    "subspecialties": [
      "Stroke",
      "Other"
    ],
    "clinical_pearls": [
      "Estimates both 10-year risk (validated for ages 30–79) and 30-year risk (validated for ages 30–59) across 5 endpoints: ASCVD, Heart Failure, Coronary Heart Disease, Stroke, and Total CVD.",
      "BMI (18.5–39.9 kg/m²) is used specifically in the Heart Failure models; if omitted, ASCVD, CHD, Stroke, and Total CVD risks are still computed.",
      "Optional uACR, HbA1c, and Social Deprivation Index (SDI) automatically select the enhanced PREVENT model (Base, +uACR, +HbA1c, +SDI, or Full).",
      "10-year ASCVD risk strata: <5.0% Low, 5.0–7.49% Borderline, 7.5–19.99% Intermediate, >=20.0% High.",
      "Pitfall — Exclusions (ASCVD & HeFH): Not intended for patients with established ASCVD or heterozygous familial hypercholesterolemia (HeFH), where standard risk equations underestimate risk.",
      "Pitfall — Geographic & BMI limits: Derived and validated primarily in U.S. cohorts (BMI < 18.5 or >= 40 kg/m² excluded); treatment-decision thresholds for total CVD risk are still evolving."
    ]
  },
