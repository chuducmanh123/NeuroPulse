  "metadata": {
    "kind": "point_sum",
    "name": "Barthel Index (BI) of activities of daily living",
    "aliases": [
      "BI",
      "ADL index",
      "functional independence"
    ],
    "summary": "10-item ordinal index (0–100) measuring functional independence in basic activities of daily living.",
    "short_name": "BI",
    "time_estimate": "~2–3 min",
    "subspecialties": [
      "Stroke"
    ],
    "clinical_pearls": [
      "Score what the patient actually does over the past 24–48 hours, not what they could theoretically do.",
      "Use of assistive devices (e.g., grab bars, walker, wheelchair) does NOT reduce independence points if no human help is needed.",
      "Widely validated for tracking longitudinal stroke rehabilitation and predicting discharge disposition alongside mRS (Sulter et al., 1999).",
      "Pitfall — Ceiling effect & self-report bias: Patients with mild deficits may hit the maximum 100 score despite residual instrumental ADL or cognitive limitations; self-reported scores in older adults (>= 75 years) can diverge from observed performance."
    ]
  },
