{
  "id": "has-bled",
  "schema_version": 1,
  "metadata": {
    "name": "HAS-BLED Score for Major Bleeding Risk",
    "short_name": "HAS-BLED",
    "aliases": ["bleeding risk", "anticoagulation bleeding"],
    "subspecialties": ["Stroke"],
    "kind": "point_sum",
    "summary": "9-point score identifying modifiable bleeding risk factors in patients on anticoagulation for atrial fibrillation.",
    "time_estimate": "< 1 min",
    "clinical_pearls": [
      "A high HAS-BLED score (>= 3) is NOT a contraindication to anticoagulation; it flags patients needing closer monitoring and correction of modifiable risks (BP, NSAIDs, alcohol, labile INR)."
    ]
  },
  "items": [
    { "kind": "select", "id": "hb_htn", "code": "H", "label": "Hypertension (uncontrolled SBP > 160 mmHg)", "required": true, "options": [{ "id": "no", "label": "No", "points": 0 }, { "id": "yes", "label": "Yes", "points": 1 }] },
    { "kind": "select", "id": "hb_renal", "code": "A1", "label": "Abnormal Renal Function (dialysis, transplant, or SCr >= 200 µmol/L [2.26 mg/dL])", "required": true, "options": [{ "id": "no", "label": "No", "points": 0 }, { "id": "yes", "label": "Yes", "points": 1 }] },
    { "kind": "select", "id": "hb_liver", "code": "A2", "label": "Abnormal Liver Function (cirrhosis, or bilirubin > 2x ULN with AST/ALT > 3x ULN)", "required": true, "options": [{ "id": "no", "label": "No", "points": 0 }, { "id": "yes", "label": "Yes", "points": 1 }] },
    { "kind": "select", "id": "hb_stroke", "code": "S", "label": "Stroke History", "required": true, "options": [{ "id": "no", "label": "No", "points": 0 }, { "id": "yes", "label": "Yes", "points": 1 }] },
    { "kind": "select", "id": "hb_bleed", "code": "B", "label": "Bleeding History or Predisposition", "required": true, "options": [{ "id": "no", "label": "No", "points": 0 }, { "id": "yes", "label": "Yes", "points": 1 }] },
    { "kind": "select", "id": "hb_inr", "code": "L", "label": "Labile INR (on VKA with TTR < 60%)", "required": true, "options": [{ "id": "no", "label": "No / Not on VKA", "points": 0 }, { "id": "yes", "label": "Yes", "points": 1 }] },
    { "kind": "select", "id": "hb_age", "code": "E", "label": "Elderly (Age > 65 years)", "required": true, "options": [{ "id": "no", "label": "No (<= 65 years)", "points": 0 }, { "id": "yes", "label": "Yes (> 65 years)", "points": 1 }] },
    { "kind": "select", "id": "hb_drugs", "code": "D1", "label": "Concomitant Drugs (antiplatelets or NSAIDs)", "required": true, "options": [{ "id": "no", "label": "No", "points": 0 }, { "id": "yes", "label": "Yes", "points": 1 }] },
    { "kind": "select", "id": "hb_alcohol", "code": "D2", "label": "Alcohol Excess (>= 8 drinks/week)", "required": true, "options": [{ "id": "no", "label": "No", "points": 0 }, { "id": "yes", "label": "Yes", "points": 1 }] }
  ],
  "scoring": { "method": "sum", "min_score": 0, "max_score": 9, "unit": "points", "precision": 0 },
  "interpretation": [
    {
      "id": "hb_low_mod",
      "min": 0,
      "max": 2,
      "label": "Low-to-Moderate Bleeding Risk (0–2)",
      "severity": "normal",
      "summary": "HAS-BLED 0–2: lower 1-year major bleeding risk (~1.0–1.9%).",
      "refs": [{ "source_id": "pisters-2010-hasbled", "locator": "Table 3" }]
    },
    {
      "id": "hb_high",
      "min": 3,
      "max": 9,
      "label": "High Bleeding Risk (>= 3)",
      "severity": "moderate",
      "summary": "HAS-BLED >= 3: address modifiable bleeding risks and schedule closer follow-up; do not withhold indicated anticoagulation solely for high score.",
      "refs": [{ "source_id": "pisters-2010-hasbled", "locator": "Table 3" }]
    }
  ],
  "assessment_guides": [
    {
      "id": "guide_hb_inr",
      "target_type": "item",
      "target_id": "hb_inr",
      "title": "Labile INR Rule",
      "bedside_steps": [
        "Apply only to patients currently taking a vitamin K antagonist (warfarin/acenocoumarol)."
      ],
      "pitfalls_and_exceptions": [
        "Patients on DOACs or anticoagulation-naive patients score 0 for Labile INR."
      ],
      "refs": [{ "source_id": "pisters-2010-hasbled", "locator": "Table 1" }]
    }
  ],
  "references": [
    {
      "id": "pisters-2010-hasbled",
      "citation": "Pisters R, Lane DA, Nieuwlaat R, de Vos CB, Crijns HJ, Lip GY. A novel user-friendly score (HAS-BLED) to assess 1-year risk of major bleeding in patients with atrial fibrillation: the Euro Heart Survey. Chest. 2010;138(5):1093-1100.",
      "year": 2010,
      "pmid": "20299623"
    }
  ],
  "test_cases": [
    { "name": "Score 0", "inputs": { "hb_htn": "no", "hb_renal": "no", "hb_liver": "no", "hb_stroke": "no", "hb_bleed": "no", "hb_inr": "no", "hb_age": "no", "hb_drugs": "no", "hb_alcohol": "no" }, "expected_score": 0, "expected_band_id": "hb_low_mod" },
    { "name": "Boundary 2", "inputs": { "hb_htn": "no", "hb_renal": "no", "hb_liver": "no", "hb_stroke": "yes", "hb_bleed": "no", "hb_inr": "no", "hb_age": "yes", "hb_drugs": "no", "hb_alcohol": "no" }, "expected_score": 2, "expected_band_id": "hb_low_mod" },
    { "name": "Boundary 3", "inputs": { "hb_htn": "yes", "hb_renal": "no", "hb_liver": "no", "hb_stroke": "yes", "hb_bleed": "no", "hb_inr": "no", "hb_age": "yes", "hb_drugs": "no", "hb_alcohol": "no" }, "expected_score": 3, "expected_band_id": "hb_high" },
    { "name": "Max 9", "inputs": { "hb_htn": "yes", "hb_renal": "yes", "hb_liver": "yes", "hb_stroke": "yes", "hb_bleed": "yes", "hb_inr": "yes", "hb_age": "yes", "hb_drugs": "yes", "hb_alcohol": "yes" }, "expected_score": 9, "expected_band_id": "hb_high" }
  ],
  "status": "draft",
  "verification": { "verified_by": null, "verified_at": null, "content_hash": null }
}
