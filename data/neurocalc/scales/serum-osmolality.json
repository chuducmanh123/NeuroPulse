      "title": "Osmolal Gap & Mannitol Monitoring",
      "target_id": "serum-osmolality",
      "chip_label": "Osmolal Gap",
      "target_type": "scale",
      "bedside_steps": [
        "Compare measured serum osmolality (freezing-point depression) minus calculated osmolality."
      ],
      "pitfalls_and_exceptions": [
        "During mannitol therapy, the osmolal gap (typically target < 20–55 mOsm/kg) reflects circulating mannitol clearance better than serum osmolality alone."
      ]
