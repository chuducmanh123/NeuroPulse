  "metadata": {
    "kind": "formula",
    "name": "SCORE2-Diabetes (10-Year CVD Risk in Type 2 Diabetes, Age 40–69)",
    "aliases": [
      "ESC SCORE2-DM",
      "Diabetes CVD Risk"
    ],
    "summary": "Estimates 10-year fatal and non-fatal CVD risk in adults aged 40–69 with type 2 diabetes without established ASCVD or severe target organ damage.",
    "short_name": "SCORE2-Diabetes",
    "time_estimate": "~1–2 min",
    "subspecialties": [
      "Other"
    ],
    "clinical_pearls": [
      "Do not apply SCORE2-Diabetes to patients with established ASCVD or severe target-organ damage (eGFR <45, eGFR 45–59 with microalbuminuria, proteinuria, or microvascular disease in >=3 sites)—they are automatically Very High Risk per 2023 ESC Guidelines.",
      "Supports both IFCC HbA1c (mmol/mol) and NGSP HbA1c (%).",
      "Improves CVD risk discrimination over standard SCORE2 in type 2 diabetes by adding diabetes-specific predictors (age at diagnosis, HbA1c, eGFR).",
      "Pitfall — Socioeconomic & non-European calibration: Calibrated for European populations; external validations report potential underestimation in lower socioeconomic groups and variable calibration in non-European cohorts."
    ]
  },
