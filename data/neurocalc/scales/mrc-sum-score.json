  "assessment_guides": [
    {
      "id": "guide_mrc_exam",
      "target_type": "scale",
      "target_id": "mrc-sum-score",
      "chip_label": "Exam Technique",
      "title": "Standardized Bedside MRC Testing",
      "bedside_steps": [
        "Ensure patient is awake and cooperative (e.g., RASS -1 to +1) before diagnosing ICU-AW.",
        "Test each muscle group in a standardized position with gravity eliminated first if unable to move against gravity."
      ],
      "pitfalls_and_exceptions": [
        "Avoid using '+' or '-' modifiers (e.g. 4+ / 4-) when computing the formal MRC Sum Score; use integer 0–5 grades only."
      ],
      "refs": [{ "source_id": "kleyweg-1991-mrc", "locator": "p. 1104-1107" }]
    }
  ],
