{
  "id": "mrc-sum-score",
  "schema_version": 1,
  "metadata": {
    "name": "Medical Research Council (MRC) Sum Score",
    "short_name": "MRC Sum Score",
    "aliases": ["MRC-SS", "ICU-AW", "GBS muscle score", "Tetraparesis score"],
    "subspecialties": ["Neuromuscular", "Neurocritical Care"],
    "kind": "point_sum",
    "summary": "12-muscle bedside strength sum (0–60) across 6 bilateral upper and lower limb groups for GBS, CIDP, and ICU-acquired weakness.",
    "time_estimate": "2–3 min",
    "clinical_pearls": [
      "An MRC Sum Score < 48 in an awake, cooperative critically ill patient defines ICU-acquired weakness (ICU-AW); < 36 indicates severe weakness.",
      "Directly feeds into the EGRIS respiratory insufficiency score for Guillain-Barré syndrome.",
      "Demonstrates very good interobserver reliability in both GBS (Kleyweg et al., 1991) and ICU-AW (Hermans et al., 2012; ICC 0.95).",
      "Pitfall — Cooperation & floor/ceiling effects: Requires an awake, cooperative patient (RASS -1 to +1); sedation, delirium, pain, or focal orthopedic injury invalidate testing, and the ordinal 0–5 scale is less sensitive to small changes in grade 4 strength."
    ]
  },
