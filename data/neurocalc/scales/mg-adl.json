      "title": "MG-ADL 7-Day Recall & Crisis Screening",
      "target_id": "mg-adl",
      "chip_label": "Recall Window",
      "target_type": "scale",
      "bedside_steps": [
        "Ask the patient to rate their typical status over the preceding 7 days (not just a single transient moment)."
      ],
      "pitfalls_and_exceptions": [
        "Score 2 or 3 on Breathing or Swallowing requires immediate FVC/NIF assessment regardless of total score.",
        "Ensure ocular diplopia resolves with monocular occlusion."
