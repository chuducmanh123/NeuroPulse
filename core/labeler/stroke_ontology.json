  "normalization": {
    "AHA_COR": {
      "1": "strong",
      "I": "strong",
      "2a": "moderate",
      "IIa": "moderate",
      "2b": "weak",
      "IIb": "weak",
      "3: No Benefit": "no_benefit",
      "III: No Benefit": "no_benefit",
      "3: Harm": "harm",
      "III: Harm": "harm"
    },
    "AHA_LOE": {
      "A": "high",
      "B-R": "moderate",
      "B-NR": "moderate",
      "C-LD": "low",
      "C-EO": "expert_opinion"
    },
    "ESO_strength": {
      "strong for": "strong",
      "weak for": "weak",
      "weak against": "weak_against",
      "strong against": "strong_against",
      "expert consensus": "expert_opinion",
      "no recommendation / uncertain (ongoing trial)": "uncertain"
    },
    "ESO_quality": {
      "high": "high",
      "moderate": "moderate",
      "low": "low",
      "very low": "very_low",
      "uncertain / ongoing trial": "uncertain"
    },
    "note": "Always keep the raw value too. Normalization is done by code from the copied fields, never by AI."
  },
  "consistency_rules_checked_by_code": [
    {
      "id": "cor1_for",
      "if": "AHA COR = 1",
      "then": "direction must be 'for'"
    },
    {
      "id": "cor3_nb",
      "if": "AHA COR = 3: No Benefit",
      "then": "direction must be 'no_benefit' or 'against'"
    },
    {
      "id": "cor3_harm",
      "if": "AHA COR = 3: Harm",
      "then": "direction must be 'against'"
    },
    {
      "id": "cor2",
      "if": "AHA COR = 2a or 2b",
      "then": "direction must be 'for' or 'uncertain'"
    },
    {
      "id": "pediatric_text",
      "if": "text contains pediatric/children/paediatric",
      "then": "age_group must contain 'pediatric'"
    },
    {
      "id": "unlisted_flag",
      "if": "any value is other_* or other_unlisted",
      "then": "needs_review must be true"
    }
  ]
}
