    "ng:migrate-v2": "node --use-system-ca --experimental-strip-types scripts/neuroguide/migrate-to-v2.ts",
    "ng:pull-pathways": "node --use-system-ca --experimental-strip-types scripts/neuroguide/pull-pathways.ts"
